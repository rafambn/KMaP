    {
      "id": "geolines",
      "type": "line",
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "name"
          ],
          "International Date Line"
        ]
      ],
      "source": "maplibre",
      "maxzoom": 24,
      "source-layer": "geolines",
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "line-color": "#1077B0",
        "line-opacity": 1,
        "line-dasharray": [
          3,
          3
        ]
      }
    },
    {
      "id": "geolines-label",
      "type": "symbol",
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "name"
          ],
          "International Date Line"
        ]
      ],
      "source": "maplibre",
      "maxzoom": 24,
      "minzoom": 1,
      "source-layer": "geolines",
      "layout": {
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2,
          12,
          6,
          16
        ],
        "text-field": "{name}",
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#1077B0",
        "text-halo-blur": 1,
        "text-halo-color": "rgba(255, 255, 255, 1)",
        "text-halo-width": 1
      }
    },
    {
      "id": "countries-label",
      "type": "symbol",
      "filter": [
        "all"
      ],
      "source": "maplibre",
      "maxzoom": 24,
      "minzoom": 2,
      "source-layer": "centroids",
      "layout": {
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2,
          10,
          4,
          12,
          6,
          16
        ],
        "text-field": [
          "step",
          [
            "zoom"
          ],
          [
            "coalesce",
            [
              "to-string",
              [
                "get",
                "ABBREV"
              ]
            ],
            ""
          ],
          4,
          [
            "coalesce",
            [
              "to-string",
              [
                "get",
                "NAME"
              ]
            ],
            ""
          ]
        ],
        "visibility": "visible",
        "text-max-width": 10,
        "text-transform": [
          "step",
          [
            "zoom"
          ],
          "uppercase",
          2,
          "none"
        ]
      },
      "paint": {
        "text-color": "rgba(8, 37, 77, 1)",
        "text-halo-blur": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2,
          0.2,
          6,
          0
        ],
        "text-halo-color": "rgba(255, 255, 255, 1)",
        "text-halo-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2,
          1,
          6,
          1.6
        ]
      }
    },
