#!/usr/bin/env sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir="$script_dir"
kmap_dir="$project_dir/KMaP"
kover_version="0.9.9"
kover_base_url="https://repo1.maven.org/maven2/org/jetbrains/kotlinx"
kover_dir="$project_dir/build/kover"
tool_dir="$kover_dir/tools/$kover_version"
report_dir="$kmap_dir/build/reports/kover"
classes_dir="$project_dir/build/artifacts/CompiledJvmArtifact/KMaPjvm/kotlin-output"
sources_dir="$kmap_dir/src"
coverage_file="$report_dir/report.ic"
agent_args="$report_dir/agent.args"
xml_file="$report_dir/report.xml"
html_dir="$report_dir/html"
required_source_file="${KOVER_REQUIRED_SOURCE_FILE:-}"
required_coverage_package="${KOVER_REQUIRED_SOURCE_PACKAGE:-}"
required_line_coverage="${KOVER_REQUIRED_LINE_COVERAGE:-100}"
required_branch_coverage="${KOVER_REQUIRED_BRANCH_COVERAGE:-100}"
cli_jar="$tool_dir/kover-cli-$kover_version.jar"
agent_jar="$tool_dir/kover-jvm-agent-$kover_version.jar"

mkdir -p "$tool_dir" "$report_dir"

if [ -n "$required_source_file" ]; then
    case "$required_line_coverage" in
        ''|*[!0-9]*)
            echo "KOVER_REQUIRED_LINE_COVERAGE must be an integer from 0 to 100" >&2
            exit 1
            ;;
    esac

    if [ "$required_line_coverage" -gt 100 ]; then
        echo "KOVER_REQUIRED_LINE_COVERAGE must be an integer from 0 to 100" >&2
        exit 1
    fi

    case "$required_branch_coverage" in
        ''|*[!0-9]*)
            echo "KOVER_REQUIRED_BRANCH_COVERAGE must be an integer from 0 to 100" >&2
            exit 1
            ;;
    esac

    if [ "$required_branch_coverage" -gt 100 ]; then
        echo "KOVER_REQUIRED_BRANCH_COVERAGE must be an integer from 0 to 100" >&2
        exit 1
    fi
fi

download_artifact() {
    artifact_path="$1"
    target_path="$2"

    if [ -f "$target_path" ]; then
        return
    fi

    download_path="$target_path.download"
    rm -f "$download_path"
    curl --fail --silent --show-error --location --retry 3 \
        "$kover_base_url/$artifact_path" \
        --output "$download_path"
    mv "$download_path" "$target_path"
}

download_artifact \
    "kover-cli/$kover_version/kover-cli-$kover_version.jar" \
    "$cli_jar"
download_artifact \
    "kover-jvm-agent/$kover_version/kover-jvm-agent-$kover_version.jar" \
    "$agent_jar"

"$project_dir/kotlin" build -m KMaP -p jvm

if [ ! -d "$classes_dir" ]; then
    echo "KMaP JVM classes were not found at $classes_dir" >&2
    exit 1
fi

rm -rf "$html_dir"
rm -f "$coverage_file" "$xml_file" "$agent_args"

printf '%s\n' \
    "report.file=$coverage_file" \
    'include.regex=com\.rafambn\.kmap\..*' \
    > "$agent_args"

"$project_dir/kotlin" test \
    -m KMaP \
    -p jvm \
    --jvm-args="-javaagent:$agent_jar=file:$agent_args"

java -jar "$cli_jar" report "$coverage_file" \
    --classfiles "$classes_dir" \
    --src "$sources_dir" \
    --exclude 'com.rafambn.kmap.generated.*' \
    --html "$html_dir" \
    --xml "$xml_file" \
    --title 'KMaP JVM test coverage'

if [ -n "$required_source_file" ]; then
    required_source_name=${required_source_file##*/}
    required_source_package=${required_source_file%/*}

    if [ "$required_source_package" = "$required_source_file" ]; then
        required_source_package=""
    else
        required_source_package=${required_source_package#./}
        case "$required_source_package" in
            */src/*) required_source_package=${required_source_package#*/src/} ;;
            src/*) required_source_package=${required_source_package#src/} ;;
        esac
    fi

    source_coverage=$(
        awk \
            -v source_name="$required_source_name" \
            -v source_package="$required_source_package" '
            /<package name="/ {
                package = $0
                sub(/^.*<package name="/, "", package)
                sub(/".*$/, "", package)
            }

            index($0, "<sourcefile name=\"" source_name "\">") {
                if (source_package == "" || package == source_package) {
                    in_source_file = 1
                    matches += 1
                }
                next
            }

            in_source_file && /<sourcefile name=/ {
                in_source_file = 0
            }

            in_source_file && /<\/sourcefile>/ {
                in_source_file = 0
            }

            in_source_file && /<counter type="LINE"/ {
                line = $0
                sub(/^.*missed="/, "", line)
                sub(/".*$/, "", line)
                missed = line

                line = $0
                sub(/^.*covered="/, "", line)
                sub(/".*$/, "", line)
                covered = line

                line_counter_matches += 1
            }

            in_source_file && /<counter type="BRANCH"/ {
                branch = $0
                sub(/^.*missed="/, "", branch)
                sub(/".*$/, "", branch)
                missed_branches = branch

                branch = $0
                sub(/^.*covered="/, "", branch)
                sub(/".*$/, "", branch)
                covered_branches = branch

                branch_counter_matches += 1
            }

            END {
                if (matches == 1 && line_counter_matches == 1 && branch_counter_matches == 1) {
                    print missed, covered, missed_branches, covered_branches
                } else if (matches > 1) {
                    print "ambiguous", matches
                }
            }
        ' "$xml_file"
    )

    if [ -z "$source_coverage" ]; then
        echo "Kover source file was not found in the XML report: $required_source_file" >&2
        exit 1
    fi

    set -- $source_coverage
    if [ "$1" = "ambiguous" ]; then
        echo "Kover source file name is ambiguous; include its path relative to KMaP/src: $required_source_file" >&2
        exit 1
    fi

    missed_lines="$1"
    covered_lines="$2"
    missed_branches="$3"
    covered_branches="$4"
    total_lines=$((missed_lines + covered_lines))
    total_branches=$((missed_branches + covered_branches))

    if [ "$total_lines" -eq 0 ]; then
        echo "Kover source file has no executable lines: $required_source_file" >&2
        exit 1
    fi

    if [ $((covered_lines * 100)) -lt $((total_lines * required_line_coverage)) ]; then
        actual_line_coverage=$((covered_lines * 100 / total_lines))
        echo "Kover line coverage failed for $required_source_file: $actual_line_coverage% (required ${required_line_coverage}%)" >&2
        exit 1
    fi

    actual_line_coverage=$((covered_lines * 100 / total_lines))
    echo "Kover line coverage passed for $required_source_file: $actual_line_coverage% (required ${required_line_coverage}%)"

    if [ "$total_branches" -eq 0 ]; then
        echo "Kover branch coverage not applicable for $required_source_file: no executable branches"
    else
        if [ $((covered_branches * 100)) -lt $((total_branches * required_branch_coverage)) ]; then
            actual_branch_coverage=$((covered_branches * 100 / total_branches))
            echo "Kover branch coverage failed for $required_source_file: $actual_branch_coverage% (required ${required_branch_coverage}%)" >&2
            exit 1
        fi

        actual_branch_coverage=$((covered_branches * 100 / total_branches))
        echo "Kover branch coverage passed for $required_source_file: $actual_branch_coverage% (required ${required_branch_coverage}%)"
    fi
fi

if [ -n "$required_coverage_package" ]; then
    style_package_coverage=$(
        awk \
            -v target_package="$required_coverage_package" '
            function counter_value(line, attribute, value) {
                value = line
                sub(".*" attribute "=\"", "", value)
                sub("\".*", "", value)
                return value + 0
            }

            /<package name="/ {
                package = $0
                sub(/^.*<package name="/, "", package)
                sub(/".*$/, "", package)
                in_package = package == target_package || index(package, target_package "/") == 1
                if (in_package) package_found = 1
                in_sourcefile = 0
            }

            /<sourcefile name=/ {
                sourcefile_name = $0
                sub(/^.*<sourcefile name="/, "", sourcefile_name)
                sub(/".*$/, "", sourcefile_name)
                if (in_package) in_sourcefile = 1
            }

            /<\/sourcefile>/ {
                in_sourcefile = 0
            }

            /<class name="/ {
                class_name = $0
                sub(/^.*<class name="/, "", class_name)
                sub(/".*$/, "", class_name)
                in_class = 1
                if (in_package && class_name == target_package "/Light") light_found = 1
                if (in_package && class_name == target_package "/Transition") transition_found = 1
            }

            /<counter type="LINE"/ {
                missed = counter_value($0, "missed")
                covered = counter_value($0, "covered")
                if (in_package && !in_class && !in_sourcefile) {
                    package_missed_lines += missed
                    package_covered_lines += covered
                }
            }

            /<counter type="BRANCH"/ {
                missed = counter_value($0, "missed")
                covered = counter_value($0, "covered")
                if (in_package && !in_class && !in_sourcefile) {
                    package_missed_branches += missed
                    package_covered_branches += covered
                }
            }

            /<line nr="/ {
                if (in_package && in_sourcefile && sourcefile_name == "Style.kt") {
                    line_number = counter_value($0, "nr")
                    missed = counter_value($0, "mb")
                    if (line_number == 29) {
                        light_exception_found = 1
                        light_exception_missed = missed
                    } else if (line_number == 37) {
                        transition_exception_found = 1
                        transition_exception_missed = missed
                    }
                }
            }

            /<\/class>/ {
                in_class = 0
            }

            /<\/package>/ {
                in_package = 0
                in_sourcefile = 0
            }

            END {
                if (!package_found) {
                    print "missing"
                } else {
                    print package_missed_lines, package_covered_lines, package_missed_branches, package_covered_branches, light_found, transition_found, light_exception_found, light_exception_missed, transition_exception_found, transition_exception_missed
                }
            }
        ' "$xml_file"
    )

    if [ -z "$style_package_coverage" ] || [ "$style_package_coverage" = "missing" ]; then
        echo "Kover package was not found in the XML report: $required_coverage_package" >&2
        exit 1
    fi

    set -- $style_package_coverage
    missed_lines="$1"
    covered_lines="$2"
    missed_branches="$3"
    covered_branches="$4"
    light_found="$5"
    transition_found="$6"
    light_exception_found="$7"
    light_exception_missed="$8"
    transition_exception_found="$9"
    shift 9
    transition_exception_missed="$1"

    if [ "$light_found" -ne 1 ] || [ "$transition_found" -ne 1 ] \
        || [ "$light_exception_found" -ne 1 ] || [ "$transition_exception_found" -ne 1 ] \
        || [ "$light_exception_missed" -ne 1 ] || [ "$transition_exception_missed" -ne 1 ] \
        || [ "$missed_branches" -ne 2 ]; then
        echo "Kover generated-branch exceptions changed; inspect the raw report" >&2
        exit 1
    fi

    total_lines=$((missed_lines + covered_lines))
    total_branches=$((missed_branches + covered_branches))
    # Kotlin serialization's all-optional model check is constant false. Kover maps its two
    # unreachable branches to the @Serializable annotation lines in Style.kt, 29 and 37.
    generated_branches=2
    source_missed_branches=$((missed_branches - generated_branches))
    source_total_branches=$((total_branches - generated_branches))

    if [ "$missed_lines" -ne 0 ]; then
        actual_line_coverage=$((covered_lines * 100 / total_lines))
        echo "Kover line coverage failed for $required_coverage_package: $actual_line_coverage%" >&2
        exit 1
    fi

    echo "Kover line coverage passed for $required_coverage_package: 100% ($covered_lines/$total_lines)"

    if [ "$source_missed_branches" -ne 0 ] || [ "$source_total_branches" -le 0 ]; then
        actual_branch_coverage=$(((total_branches - missed_branches) * 100 / total_branches))
        echo "Kover branch coverage failed for $required_coverage_package: $actual_branch_coverage% raw, with uncovered source branches" >&2
        exit 1
    fi

    actual_raw_branch_coverage=$((covered_branches * 100 / total_branches))
    echo "Kover raw branch coverage for $required_coverage_package: $actual_raw_branch_coverage% ($covered_branches/$total_branches)"
    echo "Kover source branch coverage passed for $required_coverage_package: 100% ($((total_branches - generated_branches))/$((total_branches - generated_branches)))"
    echo "The raw report includes one unreachable Kotlin serialization branch each in Light and Transition."
fi

echo "KMaP Kover HTML report: $html_dir/index.html"
echo "KMaP Kover XML report: $xml_file"
